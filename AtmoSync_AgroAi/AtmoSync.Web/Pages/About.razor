@page "/about"

<div class="container py-5">


    <!-- Hero Section -->
    <section class="text-center mb-5">

        <h1 class="display-4 fw-bold text-primary">
            🌐 AtmoSync ArgoAi
        </h1>

        <p class="lead text-muted mt-3">
            Intelligent IoT Monitoring Platform combining
            Embedded Systems, Cloud API, AI Analytics and
            Real-Time Visualization.
        </p>


        <div class="mt-4">
            <span class="badge bg-primary p-2 me-2">
                IoT
            </span>

            <span class="badge bg-success p-2 me-2">
                AI
            </span>

            <span class="badge bg-dark p-2">
                Smart Monitoring
            </span>
        </div>

    </section>



    <!-- Project Vision -->

    <section class="mb-5">

        <div class="card shadow border-0">

            <div class="card-body p-5">


                <h2 class="fw-bold mb-3">
                     Project Vision
                </h2>


                <p class="text-muted fs-5">

                    AtmoSync ArgoAi aims to build a smart environmental
                    monitoring ecosystem where physical sensors collect
                    real-world data, backend services process information,
                    AI models analyze patterns, and users get meaningful
                    insights through a modern dashboard.

                </p>


            </div>

        </div>

    </section>






    <!-- Architecture Flow -->


    <section class="mb-5">


        <h2 class="fw-bold text-center mb-4">
            ⚙️ System Architecture
        </h2>



        <div class="row text-center g-4">


            <div class="col-md-3">

                <div class="card shadow-sm border-0 h-100">

                    <div class="card-body">

                        <h1>
                            🔌
                        </h1>

                        <h5>
                            Hardware Layer
                        </h5>

                        <p class="text-muted">
                            ESP32 + Environmental Sensors
                            collect real-time data.
                        </p>


                    </div>

                </div>

            </div>




            <div class="col-md-3">

                <div class="card shadow-sm border-0 h-100">

                    <div class="card-body">

                        <h1>
                            🖥️
                        </h1>


                        <h5>
                            Backend API
                        </h5>


                        <p class="text-muted">

                            ASP.NET Core Web API manages
                            communication and data processing.

                        </p>


                    </div>

                </div>

            </div>




            <div class="col-md-3">

                <div class="card shadow-sm border-0 h-100">

                    <div class="card-body">


                        <h1>
                            🤖
                        </h1>


                        <h5>
                            AI Layer
                        </h5>


                        <p class="text-muted">

                            Machine Learning analyzes sensor
                            patterns and predicts conditions.

                        </p>


                    </div>

                </div>

            </div>




            <div class="col-md-3">


                <div class="card shadow-sm border-0 h-100">

                    <div class="card-body">


                        <h1>
                            📊
                        </h1>


                        <h5>
                            Dashboard
                        </h5>


                        <p class="text-muted">

                            Blazor WebAssembly provides
                            real-time visualization.

                        </p>


                    </div>

                </div>

            </div>


        </div>


    </section>





    <!-- Technology Stack -->


    <section class="mb-5">


        <h2 class="fw-bold mb-4">
            🛠 Technology Stack
        </h2>


        <div class="row g-4">


            <div class="col-md-6">


                <div class="card shadow border-0">

                    <div class="card-body">


                        <h4>
                            🔧 Hardware
                        </h4>


                        <ul class="text-muted">

                            <li>ESP32 Microcontroller</li>

                            <li>DHT22 Temperature & Humidity Sensor</li>

                            <li>MQ7 Carbon Monoxide Sensor</li>

                            <li>MQ136 Gas Sensor</li>

                            <li>Relay Module & Automation Control</li>


                        </ul>


                    </div>

                </div>


            </div>





            <div class="col-md-6">


                <div class="card shadow border-0">


                    <div class="card-body">


                        <h4>
                            💻 Software
                        </h4>


                        <ul class="text-muted">

                            <li>ASP.NET Core Web API</li>

                            <li>Dapper + SQL Server</li>

                            <li>JWT Authentication</li>

                            <li>Blazor WebAssembly</li>

                            <li>Python Machine Learning</li>


                        </ul>


                    </div>


                </div>


            </div>


        </div>


    </section>






    <!-- Future Plan -->


    <section class="mb-5">


        <h2 class="fw-bold text-center mb-4">
            🔮 Future Roadmap
        </h2>


        <div class="row g-4">


            <div class="col-md-4">

                <div class="card shadow border-0 h-100">

                    <div class="card-body">


                        <h4>
                            Phase 1
                        </h4>


                        <p class="text-muted">

                            ✔ Real-time sensor monitoring<br />
                            ✔ Dashboard analytics<br />
                            ✔ Device management


                        </p>


                    </div>


                </div>

            </div>




            <div class="col-md-4">

                <div class="card shadow border-0 h-100">


                    <div class="card-body">


                        <h4>
                            Phase 2
                        </h4>


                        <p class="text-muted">

                            ✔ AI prediction model<br />
                            ✔ Automated alerts<br />
                            ✔ Smart decision system


                        </p>


                    </div>


                </div>


            </div>





            <div class="col-md-4">


                <div class="card shadow border-0 h-100">


                    <div class="card-body">


                        <h4>
                            Phase 3
                        </h4>


                        <p class="text-muted">

                            ✔ Mobile application<br />
                            ✔ Cloud deployment<br />
                            ✔ Large scale IoT ecosystem


                        </p>


                    </div>


                </div>


            </div>



        </div>


    </section>






    <!-- Closing -->

    <section class="text-center py-5">


        <h2 class="fw-bold text-primary">

            Building a smarter and connected future 🌍

        </h2>


        <p class="text-muted">

            AtmoSync ArgoAi is not just a monitoring system,
            it is a complete IoT ecosystem connecting
            hardware, software and intelligence.

        </p>


    </section>


</div>