@page "/dht22"

@using AtmoSync.Shared.Models.DtoModels
@using AtmoSync.Web.Services

@inject DhtSensorApiService SensorService

<div class="container py-4">

    <h2 class="fw-bold mb-4">
        🌡️ DHT22 Sensor Dashboard
    </h2>

    <div class="row g-4">

        <div class="card shadow-sm mb-4">
            <div class="card-body">

                <div class="row align-items-end">

                    <div class="col-md-4">
                        <label class="form-label">
                            From Date
                        </label>

                        <InputDate class="form-control"
                                   @bind-Value="FromDate" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">
                            To Date
                        </label>

                        <InputDate class="form-control"
                                   @bind-Value="ToDate" />
                    </div>

                    <div class="col-md-4">
                        <button class="btn btn-primary me-2"
                                @onclick="FilterByDate">
                            Search
                        </button>

                        <button class="btn btn-outline-secondary"
                                @onclick="LoadAllData">
                            Reset
                        </button>
                    </div>

                </div>

            </div>
        </div>

        <!-- Latest Sensor -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-primary text-white">
                    Latest Sensor Reading
                </div>

                <div class="card-body">

                    @if (LatestSensor is not null)
                    {
                        <div class="row text-center">

                            <div class="col-6">
                                <h3 class="text-danger">
                                    @LatestSensor.Temperature°C
                                </h3>

                                <small class="text-muted">
                                    Temperature
                                </small>
                            </div>

                            <div class="col-6">
                                <h3 class="text-info">
                                    @LatestSensor.Humidity%
                                </h3>

                                <small class="text-muted">
                                    Humidity
                                </small>
                            </div>

                        </div>

                        <hr />

                        <p class="mb-1">
                            <strong>Created By:</strong>
                            @LatestSensor.CreatedBy
                        </p>

                        <p class="mb-0 text-muted">
                            @LatestSensor.CreatedAt.ToString("dd MMM yyyy hh:mm tt")
                        </p>
                    }
                    else
                    {
                        <p>No data found.</p>
                    }

                </div>
            </div>
        </div>


        <!-- Last 5 Readings -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-success text-white">
                    Recent Readings
                </div>

                <div class="card-body">

                    @if (RecentReadings.Any())
                    {
                        @foreach (var item in RecentReadings)
                        {
                            <div class="d-flex justify-content-between align-items-center border-bottom py-2">

                                <div>
                                    <span class="badge bg-danger">
                                        @item.Temperature°C
                                    </span>

                                    <span class="badge bg-info">
                                        @item.Humidity%
                                    </span>
                                </div>

                                <small class="text-muted">
                                    @item.CreatedAt.ToString("dd MMM HH:mm")
                                </small>

                            </div>
                        }
                    }
                    else
                    {
                        <p>No recent readings available.</p>
                    }

                </div>
            </div>
        </div>

    </div>

    <!-- All Sensors Table -->
    <div class="card border-0 shadow-sm mt-4">

        <div class="card-header bg-dark text-white">
            All Sensor Records
        </div>

        <div class="card-body">

            @if (IsLoading)
            {
                <div class="text-center py-4">
                    <div class="spinner-border text-primary"></div>
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>ID</th>
                                <th>Temperature</th>
                                <th>Humidity</th>
                                <th>Created By</th>
                                <th>Created At</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (Sensors.Any())
                            {
                                int index = 1;

                                @foreach (var item in Sensors)
                                {
                                    <tr>

                                        <td>@index</td>

                                        <td>
                                            <span class="badge bg-secondary">
                                                #@item.Id
                                            </span>
                                        </td>

                                        <td>
                                            <span class="text-danger fw-bold">
                                                @item.Temperature°C
                                            </span>
                                        </td>

                                        <td>
                                            <span class="text-primary fw-bold">
                                                @item.Humidity%
                                            </span>
                                        </td>

                                        <td>@item.CreatedBy</td>

                                        <td>
                                            @item.CreatedAt.ToString("dd MMM yyyy")
                                        </td>

                                        <td>
                                            <button class="btn btn-sm btn-outline-danger"
                                                    @onclick="() => DeleteSensor(item.Id)">
                                                Delete
                                            </button>
                                        </td>

                                    </tr>

                                    index++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-4">
                                        No sensor data found
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>

@code {

    private DateTime FromDate = DateTime.Today.AddDays(-7);
    private DateTime ToDate = DateTime.Today;

    private bool IsLoading = true;

    private List<DHTSensorDto> Sensors = new();
    private List<DHTSensorDto> RecentReadings = new();

    private DHTSensorDto? LatestSensor;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        IsLoading = true;

        // Get All Sensors
        var allResponse = await SensorService.GetAllAsync();

        if (allResponse?.Code == 200 && allResponse.Data != null)
        {
            Sensors = allResponse.Data
                .OrderByDescending(x => x.CreatedAt)
                .ToList();
        }

        // Latest Sensor Reading
        var latestResponse = await SensorService.GetLatestAsync();

        if (latestResponse?.Code == 200)
        {
            LatestSensor = latestResponse.Data;
        }

        // Recent 5 Readings
        var recentResponse = await SensorService.GetLatestReadingsAsync(5);

        if (recentResponse?.Code == 200 && recentResponse.Data != null)
        {
            RecentReadings = recentResponse.Data;
        }

        IsLoading = false;
    }

    private async Task DeleteSensor(long id)
    {
        var response = await SensorService.DeleteAsync(id);

        if (response?.Code == 200)
        {
            await LoadData();
        }
    }

    private async Task FilterByDate()
    {
        IsLoading = true;

        var response = await SensorService
            .GetByDateRangeAsync(FromDate, ToDate);

        if (response?.Code == 200 && response.Data != null)
        {
            Sensors = response.Data
                .OrderByDescending(x => x.CreatedAt)
                .ToList();
        }
        else
        {
            Sensors = new();
        }

        IsLoading = false;
    }

    private async Task LoadAllData()
    {
        FromDate = DateTime.Today.AddDays(-7);
        ToDate = DateTime.Today;

        await LoadData();
    }
}