@page "/"

@using AtmoSync.Web.Services
@using AtmoSync.Shared.Models.DtoModels
@using Microsoft.JSInterop

@inject DhtSensorApiService DhtService
@inject MQ136SensorApiService MQ136Service
@inject MQ7SensorApiService MQ7Service
@inject IJSRuntime JS


<PageTitle>AtmoSync Dashboard</PageTitle>


<div class="dashboard-shell">
    <section class="hero-panel">
        <div class="hero-copy">
            <p class="eyebrow">AgroIoT operations center</p>
            <h1>Environmental monitoring designed for dependable farm intelligence.</h1>
            <p class="hero-text">
                Track live temperature, humidity, carbon monoxide, and hydrogen sulfide readings from your connected sensors in a clear, professional dashboard.
            </p>
            <div class="hero-actions">
                <button class="btn btn-primary" @onclick="RefreshData">
                    <i class="bi bi-arrow-clockwise"></i> Refresh data
                </button>
                <span class="status-pill">Live updates from connected sensors</span>
            </div>
        </div>

        <div class="hero-summary">
            <div class="summary-card">
                <span class="summary-label">Current status</span>
                <strong>Stable monitoring</strong>
                <small>All sensor streams are active.</small>
            </div>
            <div class="summary-card">
                <span class="summary-label">Last refreshed</span>
                <strong>@(Dht?.CreatedAt.ToString("dd MMM yyyy hh:mm tt") ?? "Loading...")</strong>
                <small>Latest dataset timestamp</small>
            </div>
        </div>
    </section>

    <section class="stats-grid">
        <div class="stat-card stat-card-danger">
            <div class="stat-icon">🌡️</div>
            <div>
                <p class="stat-label">Temperature</p>
                @if (Dht != null)
                {
                    <h3>@Dht.Temperature °C</h3>
                    <span>Air temperature at the sensing node</span>
                }
                else
                {
                    <div class="spinner-border spinner-border-sm"></div>
                }
            </div>
        </div>

        <div class="stat-card stat-card-primary">
            <div class="stat-icon">💧</div>
            <div>
                <p class="stat-label">Humidity</p>
                @if (Dht != null)
                {
                    <h3>@Dht.Humidity %</h3>
                    <span>Relative humidity tracking</span>
                }
                else
                {
                    <div class="spinner-border spinner-border-sm"></div>
                }
            </div>
        </div>

        <div class="stat-card stat-card-warning">
            <div class="stat-icon">🏭</div>
            <div>
                <p class="stat-label">CO Level</p>
                @if (MQ7 != null)
                {
                    <h3>@MQ7.COLevel</h3>
                    <span>Carbon monoxide concentration</span>
                }
                else
                {
                    <div class="spinner-border spinner-border-sm"></div>
                }
            </div>
        </div>

        <div class="stat-card stat-card-success">
            <div class="stat-icon">☣️</div>
            <div>
                <p class="stat-label">H₂S Level</p>
                @if (MQ136 != null)
                {
                    <h3>@MQ136.H2SLevel</h3>
                    <span>Hydrogen sulfide concentration</span>
                }
                else
                {
                    <div class="spinner-border spinner-border-sm"></div>
                }
            </div>
        </div>
    </section>

    <section class="analytics-section">
        <div class="section-heading">
            <div>
                <p class="eyebrow">Sensor analytics</p>
                <h2>Trend overview</h2>
            </div>
            <span class="section-badge">Updated from latest readings</span>
        </div>

        <div class="row g-4">
            <div class="col-lg-6">
                <div class="panel-card chart-card">
                    <div class="panel-card__header">Temperature history</div>
                    <div class="panel-card__body chart-card__body">
                        <canvas id="tempChart"></canvas>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="panel-card chart-card">
                    <div class="panel-card__header">Humidity history</div>
                    <div class="panel-card__body chart-card__body">
                        <canvas id="humidityChart"></canvas>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="panel-card chart-card">
                    <div class="panel-card__header">CO level analytics</div>
                    <div class="panel-card__body chart-card__body">
                        <canvas id="mq7Chart"></canvas>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="panel-card chart-card">
                    <div class="panel-card__header">H₂S level analytics</div>
                    <div class="panel-card__body chart-card__body">
                        <canvas id="mq136Chart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>


@code {


    private DHTSensorDto? Dht;

    private MQ136SensorDto? MQ136;

    private MQ7SensorDto? MQ7;



    private List<DHTSensorDto> DhtHistory = new();

    private List<MQ136SensorDto> MQ136History = new();

    private List<MQ7SensorDto> MQ7History = new();



    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }


    private async Task LoadData()
    {
        var dht = await DhtService.GetLatestAsync();


        Dht = dht?.Data;



        var mq136 = await MQ136Service.GetLatestAsync();


        MQ136 = mq136?.Data;




        var mq7 = await MQ7Service.GetLatestAsync();


        MQ7 = mq7?.Data;

        var dhtHistory = await DhtService.GetLatestReadingsAsync(20);


        if (dhtHistory?.Data != null)

            DhtHistory = dhtHistory.Data;




        var mq136History = await MQ136Service.GetLatestReadingsAsync(20);


        if (mq136History?.Data != null)

            MQ136History = mq136History.Data;


        var mq7History = await MQ7Service.GetLatestReadingsAsync(20);


        if (mq7History?.Data != null)

            MQ7History = mq7History.Data;

    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {


        if (firstRender)
        {


            await Task.Delay(800);



            await JS.InvokeVoidAsync(
            "renderTempChart",
            DhtHistory.Select(x => x.CreatedAt.ToString("HH:mm")).ToArray(),
            DhtHistory.Select(x => x.Temperature).ToArray()
            );




            await JS.InvokeVoidAsync(
            "renderHumidityChart",
            DhtHistory.Select(x => x.CreatedAt.ToString("HH:mm")).ToArray(),
            DhtHistory.Select(x => x.Humidity).ToArray()
            );




            await JS.InvokeVoidAsync(
            "renderMQ7Chart",
            MQ7History.Select(x => x.CreatedAt.ToString("HH:mm")).ToArray(),
            MQ7History.Select(x => x.COLevel).ToArray()
            );




            await JS.InvokeVoidAsync(
            "renderMQ136Chart",
            MQ136History.Select(x => x.CreatedAt.ToString("HH:mm")).ToArray(),
            MQ136History.Select(x => x.H2SLevel).ToArray()
            );


        }


    }


    private async Task RefreshData()
    {
        await LoadData();
        StateHasChanged();

        await JS.InvokeVoidAsync(
            "renderTempChart",
            DhtHistory.Select(x => x.CreatedAt.ToString("HH:mm")).ToArray(),
            DhtHistory.Select(x => x.Temperature).ToArray()
        );

        await JS.InvokeVoidAsync(
            "renderHumidityChart",
            DhtHistory.Select(x => x.CreatedAt.ToString("HH:mm")).ToArray(),
            DhtHistory.Select(x => x.Humidity).ToArray()
        );

        await JS.InvokeVoidAsync(
            "renderMQ7Chart",
            MQ7History.Select(x => x.CreatedAt.ToString("HH:mm")).ToArray(),
            MQ7History.Select(x => x.COLevel).ToArray()
        );

        await JS.InvokeVoidAsync(
            "renderMQ136Chart",
            MQ136History.Select(x => x.CreatedAt.ToString("HH:mm")).ToArray(),
            MQ136History.Select(x => x.H2SLevel).ToArray()
        );
    }



}