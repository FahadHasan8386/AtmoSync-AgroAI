@page "/"

@using AtmoSync.Web.Services
@using AtmoSync.Shared.Models.DtoModels
@using Microsoft.JSInterop

@inject DhtSensorApiService DhtService
@inject MQ136SensorApiService MQ136Service
@inject MQ7SensorApiService MQ7Service
@inject IJSRuntime JS


<PageTitle>AtmoSync Dashboard</PageTitle>


<div class="dashboard-shell">
    <section class="hero-panel">
        <div class="hero-copy">
            <p class="eyebrow">AgroIoT operations center</p>
            <h1>Environmental monitoring designed for dependable farm intelligence.</h1>
            <p class="hero-text">
                Track live temperature, humidity, carbon monoxide, and hydrogen sulfide readings from your connected sensors in a clear, professional dashboard.
            </p>
            <div class="hero-actions">
                <button class="btn btn-primary" @onclick="RefreshData">
                    <i class="bi bi-arrow-clockwise"></i> Refresh data
                </button>
                <span class="status-pill">Live updates from connected sensors</span>
            </div>
        </div>

        <div class="hero-summary">
            <div class="summary-card">
                <span class="summary-label">Current status</span>
                <strong>Stable monitoring</strong>
                <small>All sensor streams are active.</small>
            </div>
            <div class="summary-card">
                <span class="summary-label">Last refreshed</span>
                <strong>@(Dht?.CreatedAt.ToString("dd MMM yyyy hh:mm tt") ?? "Loading...")</strong>
                <small>Latest dataset timestamp</small>
            </div>
        </div>
    </section>

    <section class="stats-grid">
        <div class="stat-card stat-card-danger">
            <div class="stat-icon">🌡️</div>
            <div>
                <p class="stat-label">Temperature</p>
                @if (Dht != null)
                {
                    <h3>@Dht.Temperature °C</h3>
                    <span>Air temperature at the sensing node</span>
                }
                else
                {
                    <div class="spinner-border spinner-border-sm"></div>
                }
            </div>
        </div>

        <div class="stat-card stat-card-primary">
            <div class="stat-icon">💧</div>
            <div>
                <p class="stat-label">Humidity</p>
                @if (Dht != null)
                {
                    <h3>@Dht.Humidity %</h3>
                    <span>Relative humidity tracking</span>
                }
                else
                {
                    <div class="spinner-border spinner-border-sm"></div>
                }
            </div>
        </div>

        <div class="stat-card stat-card-warning">
            <div class="stat-icon">🏭</div>
            <div>
                <p class="stat-label">CO Level</p>
                @if (MQ7 != null)
                {
                    <h3>@MQ7.COLevel</h3>
                    <span>Carbon monoxide concentration</span>
                }
                else
                {
                    <div class="spinner-border spinner-border-sm"></div>
                }
            </div>
        </div>

        <div class="stat-card stat-card-success">
            <div class="stat-icon">☣️</div>
            <div>
                <p class="stat-label">H₂S Level</p>
                @if (MQ136 != null)
                {
                    <h3>@MQ136.H2SLevel</h3>
                    <span>Hydrogen sulfide concentration</span>
                }
                else
                {
                    <div class="spinner-border spinner-border-sm"></div>
                }
            </div>
        </div>
    </section>

    <section class="container-fluid mt-5">

        <div class="row g-4">

            <div class="col-lg-6">
                <div class="card shadow border-0 rounded-4 h-100">
                    <div class="card-header bg-danger text-white fw-bold">
                        🌡 Temperature History
                    </div>

                    <div class="card-body">
                        <div class="chart-container">
                            <canvas id="tempChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card shadow border-0 rounded-4 h-100">
                    <div class="card-header bg-primary text-white fw-bold">
                        💧 Humidity History
                    </div>

                    <div class="card-body">
                        <div class="chart-container">
                            <canvas id="humidityChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card shadow border-0 rounded-4 h-100">
                    <div class="card-header bg-warning fw-bold">
                        🏭 CO Analytics
                    </div>

                    <div class="card-body">
                        <div class="chart-container">
                            <canvas id="mq7Chart"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card shadow border-0 rounded-4 h-100">
                    <div class="card-header bg-success text-white fw-bold">
                        ☣ H₂S Analytics
                    </div>

                    <div class="card-body">
                        <div class="chart-container">
                            <canvas id="mq136Chart"></canvas>
                        </div>
                    </div>
                </div>
            </div>

        </div>

    </section>
    
</div>


@code
{
    private DHTSensorDto? Dht;
    private MQ136SensorDto? MQ136;
    private MQ7SensorDto? MQ7;

    private List<DHTSensorDto> DhtHistory = new();
    private List<MQ136SensorDto> MQ136History = new();
    private List<MQ7SensorDto> MQ7History = new();

    private bool IsLoading;

    private PeriodicTimer? _timer;
    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            IsLoading = true;

            await LoadCharts();

            IsLoading = false;

            StateHasChanged();

            _timer = new PeriodicTimer(TimeSpan.FromSeconds(10));

            _ = Task.Run(async () =>
            {
                try
                {
                    while (await _timer.WaitForNextTickAsync(_cts.Token))
                    {
                        await InvokeAsync(async () =>
                        {
                            await LoadCharts();

                            StateHasChanged();
                        });
                    }
                }
                catch (OperationCanceledException)
                {

                }
            });
        }
    }

    private async Task LoadCharts()
    {
        // Latest Cards

        Dht = (await DhtService.GetLatestAsync())?.Data;

        MQ7 = (await MQ7Service.GetLatestAsync())?.Data;

        MQ136 = (await MQ136Service.GetLatestAsync())?.Data;


        // DHT22 History

        var dhtResponse = await DhtService.GetLatestReadingsAsync(20);

        if (dhtResponse?.Data != null)
        {
            DhtHistory = dhtResponse.Data
                .OrderBy(x => x.CreatedAt)
                .ToList();

            await JS.InvokeVoidAsync(
                "renderTempChart",
                DhtHistory.Select(x => x.CreatedAt.ToString("HH:mm")).ToArray(),
                DhtHistory.Select(x => (float)x.Temperature).ToArray());

            await JS.InvokeVoidAsync(
                "renderHumidityChart",
                DhtHistory.Select(x => x.CreatedAt.ToString("HH:mm")).ToArray(),
                DhtHistory.Select(x => (float)x.Humidity).ToArray());
        }


        // MQ7 History

        var mq7Response = await MQ7Service.GetLatestReadingsAsync(20);

        if (mq7Response?.Data != null)
        {
            MQ7History = mq7Response.Data
                .OrderBy(x => x.CreatedAt)
                .ToList();

            await JS.InvokeVoidAsync(
                "renderMQ7Chart",
                MQ7History.Select(x => x.CreatedAt.ToString("HH:mm")).ToArray(),
                MQ7History.Select(x => (float)x.COLevel).ToArray());
        }

        // MQ136 History

        var mq136Response = await MQ136Service.GetLatestReadingsAsync(20);

        if (mq136Response?.Data != null)
        {
            MQ136History = mq136Response.Data
                .OrderBy(x => x.CreatedAt)
                .ToList();

            await JS.InvokeVoidAsync(
                "renderMQ136Chart",
                MQ136History.Select(x => x.CreatedAt.ToString("HH:mm")).ToArray(),
                MQ136History.Select(x => (float)x.H2SLevel).ToArray());
        }
    }

    private async Task RefreshData()
    {
        IsLoading = true;

        await LoadCharts();

        IsLoading = false;

        StateHasChanged();
    }

    public void Dispose()
    {
        _cts.Cancel();
        _timer?.Dispose();
        _cts.Dispose();
    }
}