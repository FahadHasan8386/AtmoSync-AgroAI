@page "/mq136"

@using AtmoSync.Shared.Models.DtoModels
@using AtmoSync.Web.Component
@using AtmoSync.Web.Services

@inject MQ136SensorApiService SensorService

<div class="dashboard-shell">
    <section class="hero-panel">
        <div class="hero-copy">
            <p class="eyebrow">MQ136 gas monitoring</p>
            <h1>Hydrogen sulfide tracking in a clear and reliable operations view.</h1>
            <p class="hero-text">
                Monitor gas levels, review recent history, and manage sensor activity with a modern control-panel experience.
            </p>
            <div class="hero-actions">
                <button class="btn btn-light text-primary" @onclick="LoadData">
                    <i class="bi bi-arrow-clockwise"></i> Refresh data
                </button>
                <span class="status-pill">Gas monitoring live</span>
            </div>
        </div>

        <div class="hero-summary">
            <div class="summary-card">
                <span class="summary-label">Latest gas level</span>
                <strong>@(LatestSensor?.H2SLevel ?? 0) ppm</strong>
                <small>Current H₂S concentration</small>
            </div>
            <div class="summary-card">
                <span class="summary-label">Active sensors</span>
                <strong>@Sensors.Count(s => !s.InActive)</strong>
                <small>Currently active units</small>
            </div>
        </div>
    </section>

    <section class="stats-grid">
        <div class="stat-card stat-card-danger">
            <div class="stat-icon">☣️</div>
            <div>
                <p class="stat-label">Gas level</p>
                <h3>@(LatestSensor?.H2SLevel ?? 0) ppm</h3>
                <span>Latest reading</span>
            </div>
        </div>

        <div class="stat-card stat-card-success">
            <div class="stat-icon">📦</div>
            <div>
                <p class="stat-label">Total records</p>
                <h3>@Sensors.Count</h3>
                <span>Database entries</span>
            </div>
        </div>

        <div class="stat-card stat-card-warning">
            <div class="stat-icon">🕒</div>
            <div>
                <p class="stat-label">Last update</p>
                <h3>@(LatestSensor?.CreatedAt.ToString("dd MMM") ?? "-")</h3>
                <span>@(LatestSensor?.CreatedAt.ToString("hh:mm tt") ?? "-")</span>
            </div>
        </div>

        <div class="stat-card stat-card-primary">
            <div class="stat-icon">✅</div>
            <div>
                <p class="stat-label">Active sensors</p>
                <h3>@Sensors.Count(s => !s.InActive)</h3>
                <span>Currently active</span>
            </div>
        </div>
    </section>

    <section class="analytics-section">
        <div class="section-heading">
            <div>
                <p class="eyebrow">Filter and review</p>
                <h2>Gas records</h2>
            </div>
            <span class="section-badge">Latest 5 readings</span>
        </div>

        <div class="panel-card sensor-filter-card mb-4">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label">From date</label>
                    <InputDate class="form-control" @bind-Value="FromDate" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">To date</label>
                    <InputDate class="form-control" @bind-Value="ToDate" />
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button class="btn btn-primary" @onclick="FilterByDate">
                        <i class="bi bi-search"></i> Search
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="LoadData">
                        Reset
                    </button>
                </div>
            </div>
        </div>

        <div class="panel-card mb-4">
            <div class="panel-card__header d-flex justify-content-between align-items-center">
                <span>Recent readings</span>
                <span class="badge bg-primary">Last 5 records</span>
            </div>
            <div class="panel-card__body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Gas level</th>
                                <th>Created by</th>
                                <th>Date time</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (RecentReadings.Any())
                            {
                                int recentIndex = 1;
                                @foreach (var item in RecentReadings)
                                {
                                    <tr>
                                        <td>@recentIndex</td>
                                        <td><span class="badge bg-danger">@item.H2SLevel ppm</span></td>
                                        <td>@item.CreatedBy</td>
                                        <td>@item.CreatedAt.ToString("dd MMM yyyy hh:mm tt")</td>
                                    </tr>
                                    recentIndex++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="panel-card">
            <div class="panel-card__header d-flex justify-content-between align-items-center">
                <span>Sensor records</span>
                <span class="badge bg-dark">@Sensors.Count records</span>
            </div>
            <div class="panel-card__body">
                @if (IsLoading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary"></div>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>ID</th>
                                    <th>Gas level</th>
                                    <th>Created by</th>
                                    <th>Created at</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Sensors.Any())
                                {
                                    int index = 1;
                                    @foreach (var item in Sensors)
                                    {
                                        <tr>
                                            <td>@index</td>
                                            <td><span class="badge bg-secondary">#@item.Id</span></td>
                                            <td><span class="badge bg-danger">@item.H2SLevel ppm</span></td>
                                            <td>@item.CreatedBy</td>
                                            <td>@item.CreatedAt.ToString("dd MMM yyyy hh:mm tt")</td>
                                            <td>
                                                @if (item.InActive)
                                                {
                                                    <span class="badge bg-danger">Inactive</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">Active</span>
                                                }
                                            </td>
                                            <SensorActions InActive="@item.InActive"
                                                           ToggleStatus="@(x => ChangeStatus(item.Id,x))"
                                                           Delete="@( () => DeleteSensor(item.Id))" />
                                        </tr>
                                        index++;
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7" class="text-center text-muted py-4">No sensor data found.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </section>
</div>

@code {

    private bool IsLoading = true;

    private DateTime FromDate = DateTime.Today.AddDays(-7);
    private DateTime ToDate = DateTime.Today;

    private List<MQ136SensorDto> Sensors = new();
    private List<MQ136SensorDto> RecentReadings = new();

    private MQ136SensorDto? LatestSensor;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        IsLoading = true;

        var all = await SensorService.GetAllAsync();

        if (all?.Code == 200 && all.Data != null)
        {
            Sensors = all.Data;
        }

        var latest = await SensorService.GetLatestAsync();

        if (latest?.Code == 200)
        {
            LatestSensor = latest.Data;
        }

        var recent = await SensorService.GetLatestReadingsAsync(5);

        if (recent?.Code == 200 && recent.Data != null)
        {
            RecentReadings = recent.Data;
        }

        IsLoading = false;
    }

    private async Task FilterByDate()
    {
        IsLoading = true;

        var result = await SensorService.GetByDateRangeAsync(
            FromDate,
            ToDate);

        if (result?.Code == 200 && result.Data != null)
        {
            Sensors = result.Data;
        }

        IsLoading = false;
    }

    private async Task ActivateSensor(long id)
    {
        await ChangeStatus(id, false);
    }

    private async Task DeactivateSensor(long id)
    {
        await ChangeStatus(id, true);
    }

    private async Task ChangeStatus(long id, bool inActive)
    {
        var result = await SensorService.UpdateStatusAsync(
            id,
            inActive);

        if (result?.Code == 200)
        {
            await LoadData();
        }
    }

    private async Task DeleteSensor(long id)
    {
        var result = await SensorService.DeleteAsync(id);

        if (result?.Code == 200)
        {
            await LoadData();
        }
    }
}
